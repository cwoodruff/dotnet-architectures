{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "modern-artists": {
        "ClusterId": "modern",
        "Order": 1,
        "Match": { "Path": "/artists/{**remainder}" }
      },
      "legacy-everything-else": {
        "ClusterId": "legacy",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "modern": {
        "Destinations": { "default": { "Address": "https+http://modern-api" } }
      },
      "legacy": {
        "Destinations": { "default": { "Address": "https+http://legacy" } }
      }
    }
  }
}
