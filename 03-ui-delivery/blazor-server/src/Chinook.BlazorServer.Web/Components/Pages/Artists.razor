@page "/artists"
@rendermode InteractiveServer
@using Chinook.BlazorServer.Web.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ChinookDbContext> DbFactory

<PageTitle>Artists</PageTitle>

<h1>Artists</h1>
<p>The first ten artists by name, with their album counts. This component runs on the server and pushes UI diffs to the browser over a SignalR circuit.</p>

<button class="btn btn-primary mb-3" @onclick="LoadAsync" disabled="@loading">Reload</button>

@if (artists is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Artist</th><th>Albums</th></tr>
        </thead>
        <tbody>
            @foreach (var artist in artists)
            {
                <tr><td>@artist.Name</td><td>@artist.AlbumCount</td></tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">Loaded at @loadedAt.ToString("T")</p>
}

@code {
    private sealed record ArtistSummary(int Id, string Name, int AlbumCount);

    private List<ArtistSummary>? artists;
    private DateTime loadedAt;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            // A component lives as long as the circuit, not the HTTP request, so a scoped DbContext would be
            // shared by every event on this page for minutes or hours. Each operation gets its own short-lived
            // context from the factory instead, and disposes it when done.
            await using var db = await DbFactory.CreateDbContextAsync();
            artists = await db.Artists
                .AsNoTracking()
                .OrderBy(a => a.Name)
                .Take(10)
                .Select(a => new ArtistSummary(a.Id, a.Name ?? "(unnamed)", a.Albums.Count))
                .ToListAsync();
            loadedAt = DateTime.Now;
        }
        finally
        {
            loading = false;
        }
    }
}
