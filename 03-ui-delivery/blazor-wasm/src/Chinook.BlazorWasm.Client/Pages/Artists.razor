@page "/artists"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Artists</PageTitle>

<h1>Artists</h1>
<p>The first ten artists by name, with their album counts. This component runs in the browser on WebAssembly and fetches JSON from the API.</p>

@if (error is not null)
{
    <div class="alert alert-danger">Could not reach the API: @error</div>
}
else if (artists is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Artist</th><th>Albums</th></tr>
        </thead>
        <tbody>
            @foreach (var artist in artists)
            {
                <tr><td>@artist.Name</td><td>@artist.AlbumCount</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private sealed record ArtistSummary(int Id, string Name, int AlbumCount);

    private List<ArtistSummary>? artists;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            artists = await Http.GetFromJsonAsync<List<ArtistSummary>>("artists") ?? [];
        }
        catch (HttpRequestException ex)
        {
            error = ex.Message;
        }
    }
}
